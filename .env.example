# ══════════════════════════════════════════════════
# Archivo de ejemplo — copiar como .env y completar
# ══════════════════════════════════════════════════

# ── Dominio ──
# Usar 'localhost' para desarrollo local
# Usar el dominio real para producción (ej: facturacion.miempresa.com)
DOMAIN=localhost

# ── Base de Datos ──
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=facturacion
POSTGRES_USER=admin
POSTGRES_PASSWORD=
# Puerto externo para acceder a la DB desde fuera de Docker (opcional)
DB_EXTERNAL_PORT=5433

# ── Correo Electrónico (Ingesta de facturas) ──
EMAIL_USER=
EMAIL_PASSWORD=

# ── Correo Electrónico (Eventos DIAN - CEN) ──
EMAIL_EVENTS_USER=
EMAIL_EVENTS_PASSWORD=

# ── Webhook ──
WEBHOOK_SECRET=

# ── CORS ──
# Orígenes permitidos separados por coma.
# En producción con Caddy, el frontend y la API comparten dominio,
# pero se recomienda incluirlo igualmente.
CORS_ORIGINS=https://${DOMAIN}

# ── Chatbot (LLM) ──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=45

# ── Frontend ──
# URL del repositorio Git del frontend (Docker lo clona automáticamente)
FRONTEND_REPO=https://github.com/tu-org/tu-frontend.git

# ── Firma Digital ──
# Ruta al bundle de certificados raíz para validación de firma
RUTA_CA_CONFIABLE_XML_DSIG=input/credentials/ca_bundle.pem
