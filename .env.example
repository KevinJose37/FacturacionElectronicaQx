# Variables de entorno para el módulo de ingesta de correos
# Copiar este archivo como .env y completar los valores reales

# Credenciales de correo electrónico
# Usuario (email) y contraseña de aplicación de Gmail
EMAIL_USER='tu_cuenta@gmail.com'
EMAIL_PASSWORD='tu_password_de_aplicacion_aqui'

# ──────────────────────────────────────────────
# Base de Datos (solo si queue.backend = "postgres")
# ──────────────────────────────────────────────
# Contraseña del usuario indicado en settings.yaml
POSTGRES_PASSWORD='tu_password_de_db_aqui'


# ──────────────────────────────────────────────
# Configuración de Webhook
# ──────────────────────────────────────────────
# Secreto para validar peticiones entrantes a api.py
WEBHOOK_SECRET='una_clave_aleatoria_y_segura_aqui'


POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=facturacion
POSTGRES_USER=admin
